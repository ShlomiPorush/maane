# Production: postgres.env next to docker-compose.yml, read only by the postgres service. Generated once on the server
# into an owner-only file (mode 600) together with app.env, by the step in docs/deployment.md that refuses to
# overwrite; never copied from here and never committed. The stack refuses to start without it.

POSTGRES_USER=maane
POSTGRES_DB=maane
# 32 random bytes as hex (openssl rand -hex 32): hex keeps the database URL in app.env valid. app.env's DATABASE_URL
# holds the same value.
POSTGRES_PASSWORD=
