# Copy to .env next to docker-compose.yml. Compose reads it only to fill in docker-compose.yml; no container receives
# it. Keep it to these values, none of which is a secret: the database password and the keys go in postgres.env and
# app.env next to it (contracts in docker/env/), generated as docs/deployment.md describes. Never commit any of them.

# Image tag to run: the release being deployed. No default, so an unset value fails instead of resolving to latest.
VERSION=
# Host name Traefik routes to Maane. MAANE_PUBLIC_URL becomes https://<DOMAIN>.
DOMAIN=maane.example.com
