# Copy to .env next to docker-compose.yml, restrict it (chmod 600 .env), and fill it in as docs/deployment.md
# describes. Example values only: never commit .env. The secrets below stay empty here on purpose: the stack refuses
# to start until they are set, and they must be generated, never copied.

# --- Compose ---
# Image tag to run: the release being deployed. No default, so an unset value fails instead of resolving to latest.
VERSION=
# Host name Traefik routes to Maane. MAANE_PUBLIC_URL becomes https://<DOMAIN>.
DOMAIN=maane.example.com
# PostgreSQL's password, also part of the database URL the server builds. 32 random bytes as hex
# (openssl rand -hex 32): hex keeps the URL valid.
POSTGRES_PASSWORD=

# --- App ---
# Better Auth's versioned secrets: they sign the sign-in cookies and encrypt the two-factor secrets and backup codes.
# Format <version>:<secret>, newest first; each secret 32 random bytes or more (openssl rand -hex 32). Keep it in
# your backup: without it nobody can sign in after a restore.
MAANE_AUTH_SECRETS=
# Encrypts the secrets stored in the settings. Same format; must differ from every auth secret. Keep it in your
# backup: without it the stored secrets cannot be read after a restore.
MAANE_SETTINGS_KEYS=
# The address or CIDR range Traefik uses to reach the server (the traefik network). Better Auth then reads the client
# address from X-Forwarded-For for its rate limits. Safe only while Maane is reachable through Traefik alone and
# Traefik replaces client forwarding headers.
MAANE_TRUSTED_PROXIES=
#
# Everything else is set in Maane's settings. These may override a field instead; the settings page then shows it
# locked. Leave them empty to manage them in Maane. Never set a BETTER_AUTH_* variable: the server refuses to start.
MAANE_DEFAULT_LOCALE=
MAANE_SESSION_DAYS=
